<!-- ===== Hero ===== -->
<section class="hero">
  <div class="hero__inner">
    <!-- Mascot (pettable — click / hold / drag over him) -->
    <div class="mascot mascot--hero reveal" id="hero-mascot" role="button" tabindex="0" data-i18n-aria="hero.petAria" aria-label="Pet Kit, the mascot">
      <svg viewBox="0 0 120 160">
        <use href="#mascot-shape" class="mascot__layer mascot__layer--r"/>
        <use href="#mascot-shape" class="mascot__layer mascot__layer--c"/>
        <use href="#mascot-shape" class="mascot__layer mascot__layer--base"/>
        <use href="#mascot-gear" class="mascot__gear"/>
        <use href="#mascot-eyes-open" class="mascot__eyes mascot__eyes--open"/>
        <use href="#mascot-eyes-happy" class="mascot__eyes mascot__eyes--happy"/>
      </svg>
      <span class="purr" aria-hidden="true">purrr…</span>
    </div>
    <span class="mascot-hint reveal" id="mascot-hint" data-i18n="hero.petHint">↑ pet him</span>

    <h1 class="hero__title glitch reveal" data-site-name-glitch data-text="KYTY">KYTY</h1>

    <p class="hero__sub reveal">
      <span data-i18n="hero.sub1">An open-source</span>
      <strong> PlayStation<sup>®</sup>5 </strong>
      <span data-i18n="hero.sub2">emulator pushing Sony's next-gen console onto your PC — instruction by instruction, frame by frame.</span>
    </p>

    <div class="hero__badge reveal">
      <span class="pulse-dot"></span>
      <span class="hero__badge-label" data-i18n="hero.milestone">LATEST MILESTONE</span>
      <span class="hero__badge-game">DEAD CELLS</span>
      <span class="tag tag--playable" data-i18n="status.playable">PLAYABLE</span>
    </div>

    <div class="hero__cta reveal">
      <a class="btn btn--primary" href="#compatibility">
        <span data-i18n="hero.cta1">Check Compatibility</span>
      </a>
      <a class="btn btn--outline" data-repo-link href="https://github.com/PixelDroid19/Kyty" target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
        <span data-i18n="hero.cta2">Star on GitHub</span>
      </a>
    </div>

    <div class="hero__chips reveal">
      <span class="chip">Vulkan</span>
      <span class="chip">Linux</span>
      <span class="chip">macOS</span>
      <span class="chip">Windows</span>
      <span class="chip">MIT</span>
    </div>
  </div>
  <a class="hero__scroll" href="#now-running" aria-label="Scroll down"><span></span></a>
</section>
